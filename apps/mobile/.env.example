# Firebase web config for the comradia-dev project. Copy to .env to use dev, then fill in the key:
#   cp .env.example .env
#   npx firebase-tools apps:sdkconfig web --project comradia-dev   # prints apiKey
# Tests ignore these: with EXPO_PUBLIC_FIREBASE_EMULATOR_HOST set, the app uses the emulators.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=comradia-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=comradia-dev
EXPO_PUBLIC_FIREBASE_APP_ID=1:949794653695:web:0f9d74e59b8b47959c13ca
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=comradia-dev.firebasestorage.app
# OAuth web client id for native Google sign-in (Firebase console → Authentication → Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=949794653695-t4lqd8hd0qsgkigooris49kitvi8p3ed.apps.googleusercontent.com
# Uncomment to use the local emulators (Android emulator: 10.0.2.2).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Dev builds only: a debug token registered in Firebase console → App Check. Leave empty for store builds.
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
