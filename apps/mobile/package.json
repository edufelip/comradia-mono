{
  "name": "comradia",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:dev": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist/web",
    "lint": "eslint app components constants features localization services --no-warn-ignored --cache --cache-location .expo/cache/eslint/",
    "lint:ci": "oxlint app components constants features localization services",
    "typecheck": "tsc --noEmit",
    "format": "prettier --no-error-on-unmatched-pattern --write \"app/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts,tsx}\" \"*.{js,mjs,json,ts}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"app/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts,tsx}\" \"*.{js,mjs,json,ts}\"",
    "test": "yarn test:unit",
    "test:unit": "bash scripts/testing/run-unit-tests.sh constants/**/*.test.ts features/**/*.test.ts localization/**/*.test.ts services/**/*.test.ts",
    "test:component": "jest --config jest.component.config.cjs",
    "test:component:coverage": "jest --config jest.component.config.cjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:native": "maestro test .maestro",
    "test:all": "yarn typecheck && yarn lint && yarn test && yarn test:component:coverage && yarn test:e2e"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/auth": "23.8.8",
    "@react-native-firebase/crashlytics": "23.8.8",
    "@react-native-firebase/firestore": "23.8.8",
    "@react-native-firebase/messaging": "23.8.8",
    "@react-native-firebase/storage": "23.8.8",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "firebase": "^13.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.10.5",
    "react-native-purchases-ui": "^9.10.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/sax": "1.2.7",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "ajv": "8.18.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "54.0.18",
    "lint-staged": "^17.3.0",
    "oxlint": "1.88.0",
    "plist": "^3.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sax": "1.4.4",
    "sharp": "^0.34.5",
    "test-renderer": "1.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "yaml": "2.9.0"
  },
  "private": true,
  "resolutions": {
    "@react-navigation/core": "7.16.2"
  }
}
