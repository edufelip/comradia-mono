{
  "name": "comradia-firebase",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-comradia --only auth,firestore,storage",
    "seed": "node scripts/seed.mjs --clear",
    "test": "firebase emulators:exec --project demo-comradia --only firestore,storage \"node --import tsx --test tests/*.test.ts && yarn --cwd functions test\"",
    "deploy:rules": "firebase deploy --project dev --only firestore:rules,firestore:indexes",
    "deploy:storage": "firebase deploy --project dev --only storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^26.6.6",
    "firebase": "13.2.0",
    "firebase-tools": "13.35.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
