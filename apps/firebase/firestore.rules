rules_version = '2';

// Data model and the reasons behind it: docs/architecture.md.
// The option lists below must match apps/mobile/features/profile/profile-schema.ts;
// apps/firebase/tests/schema-parity.test.ts fails when they drift.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function vibes() {
      return ['outdoorsy', 'bookworm', 'creative', 'community', 'foodie'];
    }

    function lookingFor() {
      return ['women', 'men', 'everyone'];
    }

    function valueIds() {
      return ['climate_outdoors', 'public_transit', 'bookshops_coffee', 'indie_film_music',
        'community_gardens', 'tenant_rights', 'food_markets', 'cycling', 'pets_parks',
        'volunteering'];
    }

    function unions() {
      return ['apeoesp', 'bancarios_sp', 'metalurgicos_abc', 'seesp', 'sintrajud', 'app_workers'];
    }

    function promptIds() {
      return ['perfect_sunday', 'hill_to_die_on', 'together_we_could', 'green_flag',
        'weirdly_good_at'];
    }

    // Public card other signed-in people see in Discover. Written once, complete,
    // at the end of onboarding; nothing private (birth date, phone, email) lives here.
    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'age', 'vibe', 'lookingFor', 'unionMember',
          'union', 'values', 'promptId', 'promptAnswer', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'age', 'vibe', 'lookingFor', 'unionMember',
          'union', 'values', 'promptId', 'promptAnswer', 'createdAt', 'updatedAt'])
        && isString(data.displayName, 1, 40)
        && data.age is int && data.age >= 18 && data.age <= 99
        && data.vibe in vibes()
        && data.lookingFor in lookingFor()
        && data.unionMember is bool
        && ((data.unionMember && data.union in unions())
          || (!data.unionMember && data.union == null))
        && data.values is list
        && data.values.size() >= 3 && data.values.size() <= 5
        && data.values.toSet().size() == data.values.size()
        && data.values.toSet().hasOnly(valueIds())
        && data.promptId in promptIds()
        && isString(data.promptAnswer, 1, 280)
        && data.updatedAt == request.time
        && data.createdAt is timestamp;
    }

    // Private settings only the owner reads.
    function validAccount(data) {
      return data.keys().hasOnly(['birthDate', 'sharedPassionWeight', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['birthDate', 'sharedPassionWeight', 'createdAt', 'updatedAt'])
        && data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.sharedPassionWeight is int
        && data.sharedPassionWeight >= 0 && data.sharedPassionWeight <= 100
        && data.updatedAt == request.time
        && data.createdAt is timestamp;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validAccount(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validAccount(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      // shortcut: likes are stored but never turned into matches; mutual matching needs a
      // Cloud Function (Blaze plan), see docs/architecture.md "Deferred".
      match /swipes/{targetUid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && targetUid != uid
          && request.resource.data.keys().hasOnly(['direction', 'createdAt'])
          && request.resource.data.direction in ['like', 'pass']
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
