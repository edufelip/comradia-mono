rules_version = '2';

// Data model and the reasons behind it: docs/architecture.md.
// The option lists below must match apps/mobile/features/profile/profile-schema.ts;
// apps/firebase/tests/schema-parity.test.ts fails when they drift.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function vibes() {
      return ['outdoorsy', 'bookworm', 'creative', 'community', 'foodie'];
    }

    function lookingFor() {
      return ['women', 'men', 'everyone'];
    }

    function valueIds() {
      return ['climate_outdoors', 'public_transit', 'bookshops_coffee', 'indie_film_music',
        'community_gardens', 'tenant_rights', 'food_markets', 'cycling', 'pets_parks',
        'volunteering'];
    }

    function unions() {
      return ['apeoesp', 'bancarios_sp', 'metalurgicos_abc', 'seesp', 'sintrajud', 'app_workers'];
    }

    function promptIds() {
      return ['perfect_sunday', 'hill_to_die_on', 'together_we_could', 'green_flag',
        'weirdly_good_at'];
    }

    // Public card other signed-in people see in Discover. Written once, complete,
    // at the end of onboarding; nothing private (birth date, phone, email) lives here.
    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'age', 'vibe', 'lookingFor', 'unionMember',
          'union', 'values', 'promptId', 'promptAnswer', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'age', 'vibe', 'lookingFor', 'unionMember',
          'union', 'values', 'promptId', 'promptAnswer', 'createdAt', 'updatedAt'])
        && isString(data.displayName, 1, 40)
        && data.age is int && data.age >= 18 && data.age <= 99
        && data.vibe in vibes()
        && data.lookingFor in lookingFor()
        && data.unionMember is bool
        && ((data.unionMember && data.union in unions())
          || (!data.unionMember && data.union == null))
        && data.values is list
        && data.values.size() >= 3 && data.values.size() <= 5
        && data.values.toSet().size() == data.values.size()
        && data.values.toSet().hasOnly(valueIds())
        && data.promptId in promptIds()
        && isString(data.promptAnswer, 1, 280)
        && data.updatedAt == request.time
        && data.createdAt is timestamp;
    }

    // Private settings only the owner reads.
    function validAccount(data) {
      return data.keys().hasOnly(['birthDate', 'sharedPassionWeight', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['birthDate', 'sharedPassionWeight', 'createdAt', 'updatedAt'])
        && data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.sharedPassionWeight is int
        && data.sharedPassionWeight >= 0 && data.sharedPassionWeight <= 100
        && data.updatedAt == request.time
        && data.createdAt is timestamp;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validAccount(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validAccount(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      match /swipes/{targetUid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && targetUid != uid
          && request.resource.data.keys().hasOnly(['direction', 'createdAt'])
          && request.resource.data.direction in ['like', 'pass']
          && request.resource.data.createdAt == request.time;
      }

      // The blocker's own list of who they blocked: private, written once, never edited.
      // Delete is for account deletion (there is no unblock yet).
      match /blocks/{targetUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && targetUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }
    }

    // One like per direction. The liked person reads the likes they received (that is how
    // a like back is detected), the liker reads their own. Created once, never edited.
    match /likes/{targetUid}/from/{likerUid} {
      allow read: if signedIn()
        && (request.auth.uid == targetUid || request.auth.uid == likerUid);
      allow create: if isOwner(likerUid) && likerUid != targetUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      // Either side may withdraw the like: the liker on their own behalf, or the liked
      // person when they leave or delete their account.
      allow delete: if isOwner(likerUid) || isOwner(targetUid);
    }

    /** Either one blocked the other: the same fact is written from both sides and read here. */
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a)/by/$(b))
        || exists(/databases/$(database)/documents/blocks/$(b)/by/$(a));
    }

    // The reverse index of a block, keyed by the blocked person. The target may read that
    // they were blocked (that is why the profile and chat disappear), the blocker owns the
    // entry, and the match and message rules check both directions with two exists() calls.
    match /blocks/{targetUid}/by/{blockerUid} {
      allow read: if isOwner(targetUid) || isOwner(blockerUid);
      allow create: if isOwner(blockerUid) && targetUid != blockerUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(blockerUid);
    }

    // A report is write-only from the client: nobody reads, edits or deletes one, so a
    // report can never be used to learn who reported whom or to retract a complaint.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'target', 'reason', 'details',
          'context', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporter', 'target', 'reason', 'details',
          'context', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && isString(request.resource.data.target, 1, 128)
        && request.resource.data.target != request.auth.uid
        && request.resource.data.reason in ['harassment', 'hate', 'fake', 'spam', 'underage',
          'other']
        && isString(request.resource.data.details, 0, 500)
        && request.resource.data.context in ['profile', 'chat']
        && request.resource.data.createdAt == request.time;
    }

    /** The caller is one of the two uids in the match id (a uid never contains `_`). */
    function isInMatch(matchId) {
      return signedIn() && request.auth.uid in matchId.split('_');
    }

    // A match id is the two uids sorted and joined by `_`. Both people may read it, either
    // one creates it, and only while both likes exist: `existsAfter` sees the like written
    // in the same batch, which is how a like back creates the match without a server.
    function validMatch(matchId, data) {
      return data.keys().hasOnly(['users', 'createdAt'])
        && data.users is list
        && data.users.size() == 2
        && data.users[0] is string
        && data.users[1] is string
        && data.users[0] < data.users[1]
        && matchId == data.users[0] + '_' + data.users[1]
        && data.createdAt == request.time;
    }

    match /matches/{matchId} {
      // A `get` of a match that does not exist yet must succeed: the app checks a match id
      // before it may exist (the like back creates it).
      allow get: if isInMatch(matchId);
      // The app lists with `where('users', 'array-contains', uid)`.
      allow list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if isInMatch(matchId)
        && request.auth.uid in request.resource.data.users
        && validMatch(matchId, request.resource.data)
        && !blockedBetween(request.resource.data.users[0], request.resource.data.users[1])
        && existsAfter(/databases/$(database)/documents/likes/$(request.resource.data.users[0])/from/$(request.resource.data.users[1]))
        && existsAfter(/databases/$(database)/documents/likes/$(request.resource.data.users[1])/from/$(request.resource.data.users[0]));
      // Either member may delete the match: account deletion takes the chat with it.
      allow delete: if isInMatch(matchId);

      // One chat per match, text only. The sender is one of the two; nothing is edited.
      match /messages/{messageId} {
        allow read: if isInMatch(matchId)
          && exists(/databases/$(database)/documents/matches/$(matchId));
        allow create: if isInMatch(matchId)
          && exists(/databases/$(database)/documents/matches/$(matchId))
          && !blockedBetween(matchId.split('_')[0], matchId.split('_')[1])
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && isString(request.resource.data.text, 1, 1000)
          && request.resource.data.createdAt == request.time;
        // Account deletion removes the messages the person sent, and only those.
        allow delete: if isInMatch(matchId) && resource.data.from == request.auth.uid;
      }
    }
  }
}
