rules_version = '2';

// Portraits only: photos/{uid}/{photoId}.jpg. Files are never overwritten (the app uploads a
// new id each time), so a cached download URL never goes stale. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{uid}/{file} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && resource == null
        && file.matches('^[A-Za-z0-9_-]{1,64}[.]jpg$')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
